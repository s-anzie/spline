{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "DATABASE_URL",
    "DATABASE_URL_TEST",
    "SHADOW_DATABASE_URL",
    "JWT_SECRET",
    "JWT_EXPIRES_IN",
    "PORT",
    "PATH",
    "HOME",
    "HUB_URL",
    "MACHINE_TOKEN",
    "HEARTBEAT_INTERVAL_MS",
    "SPLINE_RUNTIME_CONFIG",
    "XDG_CONFIG_HOME",
    "SPLINE_API_URL",
    "SPLINE_WORKSPACE_ID",
    "SPLINE_AGENT_ID",
    "SPLINE_AGENT_TOKEN",
    "SPLINE_AGENT_ROLE",
    "NEXT_PUBLIC_SPLINE_API_URL",
    "NEXT_PUBLIC_SPLINE_SOCKET_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^db:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types", "^db:generate"]
    },
    "dev": {
      "dependsOn": ["^db:generate"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^db:generate"],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["^db:generate"],
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:deploy": {
      "cache": false
    }
  }
}
