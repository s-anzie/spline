# Where the hub lives. Must be https for any host other than localhost: the
# worker attaches its token to every request, and the holder of that token can
# claim commands and report results as this machine (§18). Refused at startup
# otherwise.
HUB_URL=http://localhost:8765

# An actor credential issued by the hub. The worker registers with it and
# uses it for every call afterwards.
WORKER_TOKEN=change-me

# How this machine calls itself. Defaults to the OS hostname.
# WORKER_HOSTNAME=workshop-01

# How often to say "I am here" (§6.4). Must be well under the hub's
# staleness window, which is a workspace policy (§17.7).
HEARTBEAT_INTERVAL_MS=30000

# What this machine can run (§9.9). Declared, never detected — claiming a
# capability it does not have attracts work it cannot do.
WORKER_CAPABILITIES=docker,node

# Free-form tags an operator can use to steer work.
# WORKER_LABELS=gpu,eu-west
