# Where the hub lives. Must be https for any host other than localhost: the
# worker attaches its token to every request, and the holder of that token can
# claim commands and report results as this machine (§18). Refused at startup
# otherwise.
HUB_URL=http://localhost:8765

# An actor credential issued by the hub. The worker registers with it and
# uses it for every call afterwards.
WORKER_TOKEN=change-me

# How this machine calls itself. Defaults to the OS hostname.
# WORKER_HOSTNAME=workshop-01

# How often to say "I am here" (§6.4). Must be well under the hub's
# staleness window, which is a workspace policy (§17.7).
HEARTBEAT_INTERVAL_MS=30000

# What this machine can run (§9.9). Declared, never detected — claiming a
# capability it does not have attracts work it cannot do.
WORKER_CAPABILITIES=docker,node

# Free-form tags an operator can use to steer work.
# WORKER_LABELS=gpu,eu-west

# --- Execution isolation (§18.1, §7.9, §18.5). Closed by default. ---

# Where a task runs. "container" is the default and the only one that draws a
# real boundary: a process cannot confine itself, so the network, the rest of
# the disk, the machine's resources and the TOCTOU race are closed by the
# kernel or not at all.
#
# "host" runs tasks directly. Everything below still applies — allowlist,
# environment rules, timeouts — but there is no boundary. It is a deliberate
# choice, logged loudly at every start.
# EXECUTION_BACKEND=container

# docker or podman. Both take the same flags.
# CONTAINER_RUNTIME=docker

# The image tasks run in. It carries the tools, never the secrets — those are
# forwarded by name so they never appear in `ps`.
CONTAINER_IMAGE=

# Resource ceilings. A task that exceeds one is killed by the kernel, not
# asked to stop.
# CONTAINER_MEMORY=1g
# CONTAINER_CPUS=2
# CONTAINER_PIDS=512

# uid:gid inside the container. Defaults to this worker's own, so files a task
# writes into the workspace belong to whoever reads them next. Never root.
# CONTAINER_USER=1000:1000

# The programs this machine will run, comma-separated. EMPTY MEANS NONE: an
# order naming anything else is refused. A name, never a path — the program is
# resolved through the machine's PATH, which a task can never override.
WORKER_ALLOWED_COMMANDS=

# How long a task may run before it is killed, with its whole process group.
# An allowed program that never exits holds this worker forever.
# TASK_TIMEOUT_MS=900000

# How much of a task's output is kept. Reading stops there: a loop that prints
# is a memory attack that needs no payload.
# MAX_OUTPUT_BYTES=1000000
