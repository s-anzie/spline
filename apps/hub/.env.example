PORT=8765
DATABASE_URL="postgresql://spline:<password>@localhost:5433/spline_v3_dev"
DATABASE_URL_TEST="postgresql://spline:<password>@localhost:5433/spline_v3_test"
# 32 characters minimum, refused at startup below that: a signing key is only
# as strong as its length. `openssl rand -hex 32` produces a good one.
JWT_SECRET="<64+ random chars>"
JWT_EXPIRES_IN="1h"

# Signs the audit chain (§4.23). Distinct from JWT_SECRET, same 32-character
# minimum: rotating or leaking one must not compromise the other.
AUDIT_SIGNING_KEY="<64+ random chars>"

# --- HTTP hardening (§18). Every value below has a safe default. ---

# Browser origins allowed to call this API, comma-separated. Absent means
# none, which is correct until a first-party UI needs listing: a worker and a
# server-side client send no Origin and are unaffected.
# CORS_ORIGINS=https://console.example.com

# Largest request body accepted, JSON and urlencoded alike. Policy values and
# command payloads are arbitrary JSON by design; this is the ceiling on
# "arbitrary".
# BODY_LIMIT=256kb

# Rate limits, per client address. The window applies to both ceilings.
# THROTTLE_TTL_MS=60000
# Every route.
# THROTTLE_LIMIT=600
# Routes where a caller is guessing a secret: /auth/login, /auth/register.
# AUTH_THROTTLE_LIMIT=10
