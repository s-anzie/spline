generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity & Access (v3 §18) — actors, organization, memberships, credentials.
// workspaceId stays a plain indexed string until the workspace module lands;
// the FK is added by that module's migration, not guessed here.
// ---------------------------------------------------------------------------

enum ActorType {
  HUMAN
  AGENT
  WORKER
  SERVICE
}

enum WorkspaceRole {
  OWNER
  HUMAN_OPERATOR
  AGENT_MANAGER
  AGENT_CONTRIBUTOR
  READ_ONLY_AGENT
  VIEWER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())

  @@map("users")
}

/// Top of the v3 hierarchy (§4.1). Slugs are display conveniences, not
/// identifiers — ids are the identifiers, so slug carries no unique index.
model Organization {
  id         String      @id @default(uuid())
  name       String
  slug       String
  ownerId    String
  createdAt  DateTime    @default(now())
  workspaces Workspace[]

  @@index([ownerId])
  @@map("organizations")
}

enum WorkspaceStatus {
  ACTIVE
  PAUSED
  ARCHIVED
  DELETED
}

/// Main isolation unit (§4.2). Deletion is logical (status DELETED);
/// updatedAt is set by the domain through the injected clock, on purpose
/// not @updatedAt. settings always carries a non-empty policies key.
model Workspace {
  id             String                @id @default(uuid())
  organizationId String
  name           String
  slug           String
  description    String?
  status         WorkspaceStatus       @default(ACTIVE)
  settings       Json                  @default("{}")
  createdAt      DateTime              @default(now())
  updatedAt      DateTime
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    WorkspaceMembership[]
  goals          Goal[]
  tasks          Task[]
  artifacts      Artifact[]
  decisions      Decision[]
  events         Event[]
  notifications  Notification[]
  validations    Validation[]
  policies       Policy[]
  locks          ResourceLock[]
  auditEntries   AuditEntry[]
  memoryEntries  MemoryEntry[]
  repositories   Repository[]
  sessions       AgentSession[]
  commands       RuntimeCommand[]

  @@index([organizationId])
  @@map("workspaces")
}

model WorkspaceMembership {
  id          String        @id @default(uuid())
  actorType   ActorType
  actorId     String
  workspaceId String
  role        WorkspaceRole
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([actorType, actorId, workspaceId])
  @@index([workspaceId])
  @@index([actorType, actorId])
  @@map("workspace_memberships")
}

// ---------------------------------------------------------------------------
// Goals (§4.5) — observable results. Domain-agnostic: nothing here knows
// about code, Git or any Engine.
// ---------------------------------------------------------------------------

enum Priority {
  CRITICAL
  HIGH
  NORMAL
  LOW
  BACKGROUND
}

enum GoalStatus {
  PLANNED
  ACTIVE
  BLOCKED
  REVIEW
  COMPLETED
  CANCELLED
}

model Goal {
  id               String     @id @default(uuid())
  workspaceId      String
  parentGoalId     String?
  title            String
  description      String?
  successCriteria  Json       @default("[]")
  dependsOnGoalIds Json       @default("[]")
  priority         Priority   @default(NORMAL)
  ownerType        ActorType
  ownerId          String
  progress         Int        @default(0)
  status           GoalStatus @default(PLANNED)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Restrict: a parent goal is never physically removed out from under its
  // children — cancellation is the normal path.
  parentGoal Goal?      @relation("GoalHierarchy", fields: [parentGoalId], references: [id], onDelete: Restrict)
  subGoals   Goal[]     @relation("GoalHierarchy")
  tasks      Task[]
  artifacts  Artifact[]

  @@index([workspaceId, status])
  @@index([parentGoalId])
  @@map("goals")
}

/// Opaque-token credential for AGENT / WORKER / SERVICE actors (§18.2).
model ActorCredential {
  id         String    @id @default(uuid())
  actorType  ActorType
  actorId    String
  tokenHash  String
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  lastUsedAt DateTime?

  @@index([actorType, actorId])
  @@map("actor_credentials")
}

// ---------------------------------------------------------------------------
// Tasks (§4.6) — the atomic unit of work. Assignee is NOT NULL: a task is
// assigned from its first instant, never left up for grabs.
// ---------------------------------------------------------------------------

enum TaskStatus {
  PLANNED
  READY
  ASSIGNED
  RUNNING
  BLOCKED
  VALIDATING
  COMPLETED
  FAILED
  CANCELLED
}

model Task {
  id                       String      @id @default(uuid())
  workspaceId              String
  goalId                   String
  /// Opaque and nullable — the Repository Engine owns it when it lands (§4.6).
  repositoryId             String?
  title                    String
  description              String?
  acceptanceCriteria       Json        @default("[]")
  dependsOnTaskIds         Json        @default("[]")
  /// Blockers have no life outside their task (§4.22): stored in the aggregate.
  blockers                 Json        @default("[]")
  assigneeType             ActorType
  assigneeId               String
  priority                 Priority    @default(NORMAL)
  status                   TaskStatus  @default(PLANNED)
  /// Where work stood when blocked, so it resumes instead of restarting.
  statusBeforeBlock        TaskStatus?
  estimatedCost            Float?
  estimatedDurationMinutes Int?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  goal      Goal       @relation(fields: [goalId], references: [id], onDelete: Cascade)
  artifacts Artifact[]
  decisions Decision[]
  notifications Notification[]
  validations Validation[]

  @@index([workspaceId, status])
  @@index([goalId])
  @@index([assigneeType, assigneeId])
  @@map("tasks")
}

// ---------------------------------------------------------------------------
// Artifacts (§4.10, §15) — the project's durable memory. Type is a validated
// string, NOT an enum: §19.2 lets an Engine declare the types it produces, and
// a closed set would force a core migration for every community extension.
// ---------------------------------------------------------------------------

enum ArtifactStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

model Artifact {
  id            String         @id @default(uuid())
  workspaceId   String
  goalId        String?
  taskId        String?
  /// Opaque until the Repository Engine lands (§8.12).
  repositoryId  String?
  /// §15.3 lists Decision among an artifact's relations.
  decisionId    String?
  type          String
  name          String
  description   String?
  status        ArtifactStatus @default(ACTIVE)
  tags          Json           @default("[]")
  metadata      Json           @default("{}")
  /// §15.7 — audit trails, validation reports and signed bundles never change.
  immutable     Boolean        @default(false)
  createdByType ActorType
  createdById   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  goal      Goal?             @relation(fields: [goalId], references: [id], onDelete: SetNull)
  task      Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  decision  Decision?         @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  versions  ArtifactVersion[]

  @@index([workspaceId, type])
  @@index([taskId])
  @@index([goalId])
  @@index([createdAt])
  @@map("artifacts")
}

/// A real table, unlike task blockers: a version has its own identity and will
/// be referenced by validation reports and Git commits (§8.12, §11.10).
model ArtifactVersion {
  id            String    @id @default(uuid())
  artifactId    String
  version       Int
  checksum      String
  storageRef    String
  sizeBytes     Int?
  note          String?
  createdByType ActorType
  createdById   String
  createdAt     DateTime  @default(now())

  artifact Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@unique([artifactId, version])
  @@index([artifactId])
  @@map("artifact_versions")
}

// ---------------------------------------------------------------------------
// Decisions (§4.17) — why something was done, not what. Immutable by design:
// §16.10 rebuilds memory from decisions, so there is deliberately no
// updatedAt — a decision is superseded, never rewritten.
// ---------------------------------------------------------------------------

enum DecisionConfidence {
  LOW
  MEDIUM
  HIGH
}

model Decision {
  id                     String             @id @default(uuid())
  workspaceId            String
  taskId                 String?
  subject                String
  rationale              String
  alternatives           Json               @default("[]")
  outcome                String
  confidence             DecisionConfidence @default(MEDIUM)
  authorType             ActorType
  authorId               String
  supersededByDecisionId String?
  decidedAt              DateTime           @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// SetNull: deleting a task must not erase the reasoning that produced it.
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  supersededBy Decision?  @relation("DecisionSupersession", fields: [supersededByDecisionId], references: [id], onDelete: SetNull)
  supersedes   Decision[] @relation("DecisionSupersession")
  artifacts    Artifact[]

  @@index([workspaceId])
  @@index([taskId])
  @@map("decisions")
}

// ---------------------------------------------------------------------------
// Events (§4.20, §14) — the nervous system. Facts, never intentions:
// deliberately no updatedAt and no mutation path. `sequence` gives the total
// order §14.1 requires — a timestamp cannot, two facts share a millisecond.
// ---------------------------------------------------------------------------

enum EventSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

model Event {
  id          String        @id @default(uuid())
  /// Nullable: some facts sit above workspaces (a user registering).
  workspaceId String?
  type        String
  severity    EventSeverity @default(INFO)
  actorType   ActorType?
  actorId     String?
  targetType  String
  targetId    String
  payload     Json          @default("{}")
  sequence    BigInt        @default(autoincrement())
  createdAt   DateTime      @default(now())

  workspace Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  receipts  EventReceipt[]

  @@index([workspaceId, sequence])
  @@index([type])
  @@index([targetType, targetId])
  @@map("events")
}

enum EventReceiptStatus {
  PENDING
  SEEN
  ACKNOWLEDGED
  ACTED
}

/// §4.21 — taking notice is individual, so it never lives on the Event.
model EventReceipt {
  id             String             @id @default(uuid())
  eventId        String
  actorType      ActorType
  actorId        String
  status         EventReceiptStatus @default(PENDING)
  seenAt         DateTime?
  acknowledgedAt DateTime?
  actedAt        DateTime?
  createdAt      DateTime           @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, actorType, actorId])
  @@index([actorType, actorId, status])
  @@map("event_receipts")
}

enum NotificationKind {
  CHAT_MESSAGE
  SYSTEM_ALERT
}

enum NotificationScope {
  DIRECT
  BROADCAST
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  SEEN
  ACKNOWLEDGED
  ACTED_ON
  FAILED
}

/// The addressed channel (spec 4.18). Immutable once sent: no updatedAt, and
/// no mutation path anywhere in the module.
model Notification {
  id          String            @id @default(uuid())
  workspaceId String
  kind        NotificationKind
  scope       NotificationScope
  taskId      String?
  fromActorType ActorType?
  fromActorId   String?
  title       String
  body        String
  payload     Json              @default("{}")
  createdByType ActorType
  createdById   String
  createdAt   DateTime          @default(now())

  workspace  Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task       Task?                   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  recipients NotificationRecipient[]

  @@index([workspaceId, createdAt])
  @@index([workspaceId, kind])
  @@map("notifications")
}

/// One row per real recipient, written with the notification (spec 4.19).
/// A recipient has no workspace of its own: it inherits the one of its
/// notification, so every scoped query filters through the parent.
model NotificationRecipient {
  id             String         @id @default(uuid())
  notificationId String
  recipientType  ActorType
  recipientId    String
  deliveryStatus DeliveryStatus @default(PENDING)
  deliveredAt    DateTime?
  readAt         DateTime?
  acknowledgedAt DateTime?
  actionTakenAt  DateTime?
  lastSeenAt     DateTime?
  failureReason  String?
  createdAt      DateTime       @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, recipientType, recipientId])
  @@index([recipientType, recipientId, deliveryStatus])
  @@map("notification_recipients")
}

enum ValidationStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  SKIPPED
}

/// The proof (spec 4.9): a task is never finished without one. `type` is a
/// free string on purpose — spec 11.2 calls it an open list, extensible via
/// the Extension Registry (19), so an enum would make the registry a breaking
/// change to this module.
model Validation {
  id                     String           @id @default(uuid())
  workspaceId            String
  taskId                 String
  type                   String
  status                 ValidationStatus @default(PENDING)
  mandatory              Boolean          @default(true)
  requestedByType        ActorType
  requestedById          String
  executedByType         ActorType?
  executedById           String?
  output                 String?
  reportArtifactIds      Json             @default("[]")
  dependsOnValidationIds Json             @default("[]")
  createdAt              DateTime         @default(now())
  startedAt              DateTime?
  finishedAt             DateTime?
  invalidatedAt          DateTime?
  invalidationReason     String?
  updatedAt              DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([workspaceId, taskId])
  @@index([taskId, status])
  @@map("validations")
}

enum PolicyScopeType {
  ORGANIZATION
  WORKSPACE
  REPOSITORY
  GOAL
  TASK
}

enum PolicyType {
  SECURITY
  RUNTIME
  GIT
  VALIDATION
  COST
  EXTENSION
}

/// A declarative workspace rule (spec 12). `rule` is a free string like a
/// validation type: 12.3 lists examples, not a closed set, and the Runtime
/// and the Extension Registry will publish more.
///
/// workspaceId is present even for an ORGANIZATION scope: without it no query
/// is filterable per workspace, and 4.2 admits no exception. The scope says
/// where the rule comes from; workspaceId says where it is readable.
model Policy {
  id          String          @id @default(uuid())
  workspaceId String
  scopeType   PolicyScopeType
  scopeId     String
  type        PolicyType
  rule        String
  value       Json
  enabled     Boolean         @default(true)
  createdByType ActorType
  createdById   String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, scopeType, scopeId, rule])
  @@index([workspaceId, enabled])
  @@map("policies")
}

enum LockStatus {
  HELD
  RELEASED
  EXPIRED
}

/// Protects one precise resource, never a whole task (spec 4.16).
///
/// `resourceType`/`resourceId` are opaque: no foreign key towards processes,
/// files or branches, or this table would depend on everything it protects.
///
/// `activeKey` is the exclusion mechanism. It holds "type:id" while the lock
/// is held and NULL once released or expired; Postgres treats NULLs as
/// distinct in a unique index, so the constraint applies to live locks only.
/// Two concurrent acquisitions on separate connections cannot both win, and
/// the history is still kept (18.7 forbids erasing without audit).
model ResourceLock {
  id           String     @id @default(uuid())
  workspaceId  String
  resourceType String
  resourceId   String
  activeKey    String?
  ownerType    ActorType
  ownerId      String
  reason       String
  status       LockStatus @default(HELD)
  acquiredAt   DateTime   @default(now())
  expiresAt    DateTime
  releasedAt   DateTime?
  updatedAt    DateTime   @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, activeKey])
  @@index([workspaceId, status])
  @@index([ownerType, ownerId])
  @@map("resource_locks")
}

/// Spec 4.23. Immutable: no updatedAt, and no update path anywhere in the
/// module. `signature` chains each entry to the previous one, so modifying,
/// deleting or reordering a row breaks every signature after it.
///
/// `targetType`/`targetId` stay opaque, like a lock's resource: a foreign key
/// would make this table depend on everything it audits.
model AuditEntry {
  id          String   @id @default(uuid())
  /// Nullable: an organisation-level change belongs to no single workspace.
  workspaceId String?
  actorType   ActorType
  actorId     String
  action      String
  targetType  String
  targetId    String
  before      Json?
  after       Json?
  sequence    BigInt   @default(autoincrement())
  signature   String
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, sequence])
  @@index([action])
  @@index([targetType, targetId])
  @@map("audit_entries")
}

enum MemoryScopeType {
  ORGANIZATION
  WORKSPACE
  REPOSITORY
  GOAL
  TASK
  RUN
  SESSION
}

/// Spec 16. NEVER the source of truth — the domain model is (16 opening).
///
/// An entry holds EITHER a note nobody else holds (`content`) OR a pointer at
/// the domain object that does (`sourceType`/`sourceId`), never both: a copy
/// is a second version of a decision that ages silently. The table can be
/// dropped without losing anything, which is what 16.10 requires.
model MemoryEntry {
  id             String          @id @default(uuid())
  workspaceId    String
  scopeType      MemoryScopeType
  scopeId        String
  type           String
  title          String
  content        String?
  sourceType     String?
  sourceId       String?
  tags           Json            @default("[]")
  authorType     ActorType
  authorId       String
  supersededById String?
  forgottenAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, scopeType, scopeId])
  @@index([workspaceId, type])
  /// A reference is posed once per source: reconstruction (16.10) must be
  /// repeatable without piling up duplicates.
  @@unique([workspaceId, scopeType, scopeId, sourceType, sourceId])
  @@map("memory_entries")
}

enum RepositoryStatus {
  ACTIVE
  ARCHIVED
}

enum BranchKind {
  TASK
  GOAL
  AGENT
  PROTECTED
}

enum BranchStatus {
  OPEN
  MERGED
  CLOSED
}

enum WorktreeStatus {
  OPEN
  ARCHIVED
}

enum MergeStatus {
  PENDING
  APPROVED
  REJECTED
  MERGED
}

/// Spec 8.2. The hub holds the model and the rules; the Worker holds the
/// clone — a control plane has no working copy (spec 3), so nothing here runs
/// Git. A workspace works perfectly without any of this (spec 26).
model Repository {
  id                     String           @id @default(uuid())
  workspaceId            String
  name                   String
  origin                 String
  defaultBranch          String           @default("main")
  extraProtectedBranches Json             @default("[]")
  status                 RepositoryStatus @default(ACTIVE)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  branches  Branch[]
  worktrees Worktree[]
  merges    MergeRequest[]

  @@unique([workspaceId, name])
  @@index([workspaceId, status])
  @@map("repositories")
}

/// Spec 8.3. The name is derived from what the branch is for, never supplied.
model Branch {
  id           String       @id @default(uuid())
  repositoryId String
  workspaceId  String?
  name         String
  kind         BranchKind
  taskId       String?
  goalId       String?
  status       BranchStatus @default(OPEN)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, name])
  @@index([repositoryId, status])
  @@map("branches")
}

/// Spec 8.4 — "deux tâches ne partagent jamais le même Worktree".
///
/// `openForTask` carries the task id while the worktree is open and NULL once
/// archived; Postgres treats NULLs as distinct, so the unique index applies to
/// open worktrees only. Two concurrent requests cannot both win, and the
/// history survives. Same mechanism as a lock's activeKey.
model Worktree {
  id           String         @id @default(uuid())
  repositoryId String
  workspaceId  String?
  branchId     String
  taskId       String
  openForTask  String?
  path         String
  status       WorktreeStatus @default(OPEN)
  createdAt    DateTime       @default(now())
  archivedAt   DateTime?
  updatedAt    DateTime       @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, openForTask])
  @@index([repositoryId, status])
  @@map("worktrees")
}

/// Spec 8.7 — never performed by an agent, and only once its four conditions
/// hold. The hub decides; the Worker performs.
model MergeRequest {
  id             String      @id @default(uuid())
  repositoryId   String
  workspaceId    String?
  sourceBranchId String
  targetBranchId String
  taskId         String
  status         MergeStatus @default(PENDING)
  requestedByType ActorType
  requestedById   String
  decidedByType   ActorType?
  decidedById     String?
  decisionReason String?
  createdAt      DateTime    @default(now())
  decidedAt      DateTime?
  mergedAt       DateTime?
  updatedAt      DateTime    @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId, status])
  @@index([taskId])
  @@map("merge_requests")
}

enum WorkerStatus {
  ONLINE
  OFFLINE
  DRAINING
  MAINTENANCE
}

enum SessionStatus {
  STARTING
  IDLE
  RUNNING
  WAITING
  STOPPED
  CRASHED
}

/// Spec 4.11. A machine exists above workspaces — it is attached to them
/// afterwards (6.3) and may serve several — so there is no workspaceId here.
model WorkerNode {
  id              String       @id @default(uuid())
  hostname        String
  labels          Json         @default("[]")
  architecture    String
  operatingSystem String
  capabilities    Json         @default("[]")
  workspaceIds    Json         @default("[]")
  status          WorkerStatus @default(ONLINE)
  lastHeartbeatAt DateTime?
  registeredAt    DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  sessions AgentSession[]
  commands RuntimeCommand[]

  @@unique([hostname])
  @@index([status])
  @@map("worker_nodes")
}

/// Spec 4.12 — "une session est éphémère. L'Agent est permanent."
model AgentSession {
  id              String        @id @default(uuid())
  workspaceId     String
  agentType       ActorType
  agentId         String
  workerId        String
  provider        String
  model           String?
  taskId          String?
  status          SessionStatus @default(STARTING)
  lastHeartbeatAt DateTime?
  startedAt       DateTime      @default(now())
  endedAt         DateTime?
  endReason       String?
  updatedAt       DateTime      @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  worker    WorkerNode @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([workerId, status])
  @@map("agent_sessions")
}

/// Spec 4.14 — a GLOBAL catalogue, deliberately without a workspaceId: a
/// provider's quota is an account resource shared by every agent on the same
/// underlying connection (0.3.7). Effective availability is COMPUTED, never
/// stored: available AND (quotaUnavailableUntil IS NULL OR < now).
model ProviderProfile {
  id                    String    @id @default(uuid())
  provider              String    @unique
  capabilities          Json      @default("[]")
  available             Boolean   @default(true)
  quotaUnavailableUntil DateTime?
  quotaReason           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("provider_profiles")
}

enum CommandStatus {
  PENDING
  CLAIMED
  COMPLETED
  FAILED
}

/// Spec 6.8 — an order addressed TO a worker. The hub decides and enqueues;
/// the worker pulls, executes and reports. A queue rather than a push,
/// because a worker connects outward (it may sit behind a home router) and
/// because an order nobody claimed must survive a hub restart.
model RuntimeCommand {
  id          String        @id @default(uuid())
  workspaceId String
  workerId    String
  type        String
  payload     Json          @default("{}")
  status      CommandStatus @default(PENDING)
  /// Set while claimed and NULL otherwise, so the unique index below stops
  /// two workers holding the same command — same mechanism as a lock.
  claimedBy   String?
  claimedAt   DateTime?
  finishedAt  DateTime?
  result      Json?
  failureReason String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  worker    WorkerNode @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId, status])
  @@index([workspaceId, status])
  @@map("runtime_commands")
}
