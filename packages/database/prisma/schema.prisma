generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity & Access (v3 §18) — actors, organization, memberships, credentials.
// workspaceId stays a plain indexed string until the workspace module lands;
// the FK is added by that module's migration, not guessed here.
// ---------------------------------------------------------------------------

enum ActorType {
  HUMAN
  AGENT
  WORKER
  SERVICE
}

enum WorkspaceRole {
  OWNER
  HUMAN_OPERATOR
  AGENT_MANAGER
  AGENT_CONTRIBUTOR
  READ_ONLY_AGENT
  VIEWER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())

  @@map("users")
}

/// Top of the v3 hierarchy (§4.1). Slugs are display conveniences, not
/// identifiers — ids are the identifiers, so slug carries no unique index.
model Organization {
  id         String      @id @default(uuid())
  name       String
  slug       String
  ownerId    String
  createdAt  DateTime    @default(now())
  workspaces Workspace[]

  @@index([ownerId])
  @@map("organizations")
}

enum WorkspaceStatus {
  ACTIVE
  PAUSED
  ARCHIVED
  DELETED
}

/// Main isolation unit (§4.2). Deletion is logical (status DELETED);
/// updatedAt is set by the domain through the injected clock, on purpose
/// not @updatedAt. settings always carries a non-empty policies key.
model Workspace {
  id             String                @id @default(uuid())
  organizationId String
  name           String
  slug           String
  description    String?
  status         WorkspaceStatus       @default(ACTIVE)
  settings       Json                  @default("{}")
  createdAt      DateTime              @default(now())
  updatedAt      DateTime
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    WorkspaceMembership[]
  goals          Goal[]
  tasks          Task[]
  artifacts      Artifact[]

  @@index([organizationId])
  @@map("workspaces")
}

model WorkspaceMembership {
  id          String        @id @default(uuid())
  actorType   ActorType
  actorId     String
  workspaceId String
  role        WorkspaceRole
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([actorType, actorId, workspaceId])
  @@index([workspaceId])
  @@index([actorType, actorId])
  @@map("workspace_memberships")
}

// ---------------------------------------------------------------------------
// Goals (§4.5) — observable results. Domain-agnostic: nothing here knows
// about code, Git or any Engine.
// ---------------------------------------------------------------------------

enum Priority {
  CRITICAL
  HIGH
  NORMAL
  LOW
  BACKGROUND
}

enum GoalStatus {
  PLANNED
  ACTIVE
  BLOCKED
  REVIEW
  COMPLETED
  CANCELLED
}

model Goal {
  id               String     @id @default(uuid())
  workspaceId      String
  parentGoalId     String?
  title            String
  description      String?
  successCriteria  Json       @default("[]")
  dependsOnGoalIds Json       @default("[]")
  priority         Priority   @default(NORMAL)
  ownerType        ActorType
  ownerId          String
  progress         Int        @default(0)
  status           GoalStatus @default(PLANNED)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Restrict: a parent goal is never physically removed out from under its
  // children — cancellation is the normal path.
  parentGoal Goal?      @relation("GoalHierarchy", fields: [parentGoalId], references: [id], onDelete: Restrict)
  subGoals   Goal[]     @relation("GoalHierarchy")
  tasks      Task[]
  artifacts  Artifact[]

  @@index([workspaceId, status])
  @@index([parentGoalId])
  @@map("goals")
}

/// Opaque-token credential for AGENT / WORKER / SERVICE actors (§18.2).
model ActorCredential {
  id         String    @id @default(uuid())
  actorType  ActorType
  actorId    String
  tokenHash  String
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  lastUsedAt DateTime?

  @@index([actorType, actorId])
  @@map("actor_credentials")
}

// ---------------------------------------------------------------------------
// Tasks (§4.6) — the atomic unit of work. Assignee is NOT NULL: a task is
// assigned from its first instant, never left up for grabs.
// ---------------------------------------------------------------------------

enum TaskStatus {
  PLANNED
  READY
  ASSIGNED
  RUNNING
  BLOCKED
  VALIDATING
  COMPLETED
  FAILED
  CANCELLED
}

model Task {
  id                       String      @id @default(uuid())
  workspaceId              String
  goalId                   String
  /// Opaque and nullable — the Repository Engine owns it when it lands (§4.6).
  repositoryId             String?
  title                    String
  description              String?
  acceptanceCriteria       Json        @default("[]")
  dependsOnTaskIds         Json        @default("[]")
  /// Blockers have no life outside their task (§4.22): stored in the aggregate.
  blockers                 Json        @default("[]")
  assigneeType             ActorType
  assigneeId               String
  priority                 Priority    @default(NORMAL)
  status                   TaskStatus  @default(PLANNED)
  /// Where work stood when blocked, so it resumes instead of restarting.
  statusBeforeBlock        TaskStatus?
  estimatedCost            Float?
  estimatedDurationMinutes Int?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  goal      Goal       @relation(fields: [goalId], references: [id], onDelete: Cascade)
  artifacts Artifact[]

  @@index([workspaceId, status])
  @@index([goalId])
  @@index([assigneeType, assigneeId])
  @@map("tasks")
}

// ---------------------------------------------------------------------------
// Artifacts (§4.10, §15) — the project's durable memory. Type is a validated
// string, NOT an enum: §19.2 lets an Engine declare the types it produces, and
// a closed set would force a core migration for every community extension.
// ---------------------------------------------------------------------------

enum ArtifactStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

model Artifact {
  id            String         @id @default(uuid())
  workspaceId   String
  goalId        String?
  taskId        String?
  /// Opaque until the Repository Engine lands (§8.12).
  repositoryId  String?
  type          String
  name          String
  description   String?
  status        ArtifactStatus @default(ACTIVE)
  tags          Json           @default("[]")
  metadata      Json           @default("{}")
  /// §15.7 — audit trails, validation reports and signed bundles never change.
  immutable     Boolean        @default(false)
  createdByType ActorType
  createdById   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  goal      Goal?             @relation(fields: [goalId], references: [id], onDelete: SetNull)
  task      Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  versions  ArtifactVersion[]

  @@index([workspaceId, type])
  @@index([taskId])
  @@index([goalId])
  @@index([createdAt])
  @@map("artifacts")
}

/// A real table, unlike task blockers: a version has its own identity and will
/// be referenced by validation reports and Git commits (§8.12, §11.10).
model ArtifactVersion {
  id            String    @id @default(uuid())
  artifactId    String
  version       Int
  checksum      String
  storageRef    String
  sizeBytes     Int?
  note          String?
  createdByType ActorType
  createdById   String
  createdAt     DateTime  @default(now())

  artifact Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@unique([artifactId, version])
  @@index([artifactId])
  @@map("artifact_versions")
}
