generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity & Access (not part of the original spec's "entités principales" —
// added to support real authentication / RBAC per section 6 of the spec)
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

enum WorkspaceRole {
  OWNER
  HUMAN_OPERATOR
  AGENT_MANAGER
  AGENT_CONTRIBUTOR
  READ_ONLY_AGENT
  VIEWER
}

/// Polymorphic on purpose: spec section 6 defines a *single* role model that
/// covers both humans (Owner, Human operator, Viewer) and agents (Agent
/// manager, Agent contributor, Read-only agent) — same pattern as
/// Task.assigneeType/assigneeId, no direct FK since the target table varies.
model WorkspaceMembership {
  id          String        @id @default(uuid())
  workspaceId String
  actorType   ActorType
  actorId     String
  role        WorkspaceRole
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, actorType, actorId])
  @@map("workspace_memberships")
}

/// Machine credential letting an Agent authenticate against the API/gateway,
/// distinct from human login (User).
model AgentCredential {
  id         String    @id @default(uuid())
  agentId    String    @unique
  tokenHash  String
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("agent_credentials")
}

/// Machine credential letting a LocalMachine daemon authenticate its outbound
/// WebSocket connection to MachineGateway. Same shape as AgentCredential, but
/// deliberately NOT resolved via RequesterResolver/ActorType — a machine is
/// execution infrastructure, not an RBAC actor performing workspace actions.
model MachineCredential {
  id         String    @id @default(uuid())
  machineId  String    @unique
  tokenHash  String
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  machine LocalMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@map("machine_credentials")
}

// ---------------------------------------------------------------------------
// Workspace
// ---------------------------------------------------------------------------

enum WorkspaceStatus {
  ACTIVE
  ARCHIVED
}

model Workspace {
  id          String          @id @default(uuid())
  name        String
  description String?
  status      WorkspaceStatus @default(ACTIVE)
  /// Workspace-specific rules imposed on agents (free-form, validated in the domain layer)
  ruleset     Json            @default("{}")
  /// Filesystem root a Process.cwd must resolve within (anti-traversal). Null
  /// until the owner configures it — process start is refused until then.
  rootPath    String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  memberships    WorkspaceMembership[]
  goals          Goal[]
  tasks          Task[]
  agents         Agent[]
  agentSessions  AgentSession[]
  processes      Process[]
  resourceLocks  ResourceLock[]
  decisions      Decision[]
  events         Event[]
  notifications  Notification[]
  artifacts      Artifact[]
  runtimeCommands RuntimeCommand[]

  @@map("workspaces")
}

// ---------------------------------------------------------------------------
// Goal
// ---------------------------------------------------------------------------

enum GoalStatus {
  PLANNED
  ACTIVE
  BLOCKED
  AT_RISK
  REVIEW
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ValidationState {
  NOT_REQUIRED
  PENDING
  VALIDATED
  REJECTED
}

enum ActorType {
  HUMAN
  AGENT
}

model Goal {
  id                 String          @id @default(uuid())
  workspaceId        String
  title              String
  description        String?
  status             GoalStatus      @default(PLANNED)
  priority           Priority        @default(MEDIUM)
  ownerType          ActorType
  ownerId            String
  successCriteria    Json            @default("[]")
  progressPercentage Int             @default(0)
  startDate          DateTime?
  dueDate            DateTime?
  dependencies       Json            @default("[]")
  blockers           Json            @default("[]")
  validationState    ValidationState @default(NOT_REQUIRED)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     Task[]
  artifacts Artifact[]

  @@index([workspaceId])
  @@map("goals")
}

// ---------------------------------------------------------------------------
// Task
// ---------------------------------------------------------------------------

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  DONE
  CANCELLED
}

model Task {
  id              String          @id @default(uuid())
  workspaceId     String
  goalId          String?
  title           String
  description     String?
  status          TaskStatus      @default(BACKLOG)
  priority        Priority        @default(MEDIUM)
  assigneeType    ActorType?
  assigneeId      String?
  dependencies    Json            @default("[]")
  blockers        Json            @default("[]")
  validationState ValidationState @default(NOT_REQUIRED)
  createdByType   ActorType
  createdById     String
  updatedByType   ActorType?
  updatedById     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  goal      Goal?      @relation(fields: [goalId], references: [id], onDelete: SetNull)
  artifacts Artifact[]

  @@index([workspaceId])
  @@index([goalId])
  @@map("tasks")
}

// ---------------------------------------------------------------------------
// Agent
// ---------------------------------------------------------------------------

enum AgentStatus {
  ONLINE
  OFFLINE
  BUSY
  ERROR
}

enum AgentHealthState {
  HEALTHY
  DEGRADED
  UNHEALTHY
  UNKNOWN
}

model Agent {
  id             String            @id @default(uuid())
  workspaceId    String
  provider       String
  displayName    String
  capabilities   Json              @default("[]")
  status         AgentStatus       @default(OFFLINE)
  currentTaskId  String?
  lastSeenAt     DateTime?
  promptProfile  Json              @default("{}")
  permissions    Json              @default("[]")
  healthState    AgentHealthState  @default(UNKNOWN)
  /// Decommissioned: excluded from broadcasts/assignment/session eligibility,
  /// credential revoked. Independent of `status` (live connectivity) — null
  /// means active, a timestamp means disabled.
  disabledAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  workspace  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  credential AgentCredential?
  processes  Process[]
  sessions   AgentSession[]

  @@index([workspaceId])
  @@map("agents")
}

// ---------------------------------------------------------------------------
// ProviderProfile — global catalog of what a provider (claude/codex) can do.
// Not workspace-scoped: it describes the provider generically, not a
// workspace's use of it. Seeded once with 2 rows ("claude", "codex").
// ---------------------------------------------------------------------------

enum SandboxModel {
  NONE
  READ_ONLY
  WORKSPACE_WRITE
  FULL_ACCESS
}

model ProviderProfile {
  id            String       @id @default(uuid())
  provider      String       @unique
  capabilities  Json         @default("[]")
  promptFormat  Json         @default("{}")
  approvalRules Json         @default("{}")
  hookSupport   Json         @default("[]")
  sandboxModel  SandboxModel @default(WORKSPACE_WRITE)
  outputSchema  Json         @default("{}")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("provider_profiles")
}

// ---------------------------------------------------------------------------
// LocalMachine / AgentSession — spec 5's "Local Agent Runtime": a daemon
// installed per work machine that connects outbound to MachineGateway and
// really launches/supervises claude/codex CLI sessions via child_process.
// ---------------------------------------------------------------------------

enum LocalMachineRuntimeStatus {
  ONLINE
  OFFLINE
  DEGRADED
}

model LocalMachine {
  id            String                    @id @default(uuid())
  hostname      String
  os            String
  /// Workspaces this machine is allowed to run sessions/processes for (Json
  /// array of ids — same "list of ids" convention as Agent.capabilities).
  workspaceIds  Json                      @default("[]")
  runtimeStatus LocalMachineRuntimeStatus @default(OFFLINE)
  lastSeenAt    DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  credential    MachineCredential?
  agentSessions AgentSession[]
  processes     Process[]
  commands      RuntimeCommand[]

  @@map("local_machines")
}

enum AgentSessionStatus {
  STARTING
  RUNNING
  AWAITING_APPROVAL
  COMPLETED
  FAILED
  CRASHED
  STOPPED
}

enum ApprovalState {
  NOT_REQUIRED
  PENDING
  APPROVED
  DENIED
}

model AgentSession {
  id               String              @id @default(uuid())
  agentId          String
  provider         String
  workspaceId      String
  machineId        String
  status           AgentSessionStatus  @default(STARTING)
  startedAt        DateTime            @default(now())
  lastHeartbeatAt  DateTime?
  currentProcessId String?
  currentTaskId    String?
  approvalState    ApprovalState       @default(NOT_REQUIRED)
  endedAt          DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  agent     Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  machine   LocalMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  processes Process[]

  @@index([workspaceId])
  @@index([agentId])
  @@index([machineId])
  @@map("agent_sessions")
}

// ---------------------------------------------------------------------------
// Process
// ---------------------------------------------------------------------------

enum ProcessStatus {
  STOPPED
  STARTING
  RUNNING
  STOPPING
  CRASHED
}

enum RestartPolicy {
  NEVER
  ON_FAILURE
  ALWAYS
}

model Process {
  id             String        @id @default(uuid())
  workspaceId    String
  name           String
  command        String
  cwd            String
  env            Json          @default("{}")
  status         ProcessStatus @default(STOPPED)
  ownerAgentId   String?
  /// Set together with ownerAgentId (derived from the session's agentId)
  /// when the process was launched via an AgentSession rather than directly.
  ownerSessionId String?
  /// Which LocalMachine actually runs this process — set once dispatched.
  machineId      String?
  /// OS process id on that machine — needed for the boot-time reconciliation
  /// (liveness probe) and for MachineGateway to route stop commands.
  pid            Int?
  ports          Json          @default("[]")
  logsRef        String?
  restartPolicy  RestartPolicy @default(NEVER)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerAgent   Agent?        @relation(fields: [ownerAgentId], references: [id], onDelete: SetNull)
  ownerSession AgentSession? @relation(fields: [ownerSessionId], references: [id], onDelete: SetNull)
  machine      LocalMachine? @relation(fields: [machineId], references: [id], onDelete: SetNull)
  artifacts    Artifact[]

  @@index([workspaceId])
  @@index([machineId])
  @@index([ownerSessionId])
  @@map("processes")
}

// ---------------------------------------------------------------------------
// ResourceLock
// ---------------------------------------------------------------------------

enum LockResourceType {
  PROCESS
  TASK
  WORKSPACE_RULESET
}

model ResourceLock {
  id           String            @id @default(uuid())
  workspaceId  String
  resourceType LockResourceType
  /// Opaque per resourceType (a Process id, a Task id, or a workspace-ruleset
  /// marker) — intentionally NO FK, same precedent as Task.assigneeId /
  /// Goal.ownerId / WorkspaceMembership.actorId. A real FK here would only
  /// ever point at one of the 3 possible target types and would force a
  /// resource-lock -> process/task import cycle to validate the others.
  resourceId   String
  lockedByType ActorType
  lockedById   String
  lockedAt     DateTime          @default(now())
  expiresAt    DateTime?
  reason       String?
  scope        String?
  releasedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([resourceType, resourceId])
  @@map("resource_locks")
}

// ---------------------------------------------------------------------------
// Decision
// ---------------------------------------------------------------------------

model Decision {
  id                String    @id @default(uuid())
  workspaceId       String
  subject           String
  context           String?
  optionsConsidered Json      @default("[]")
  decision          String
  decidedByType     ActorType
  decidedById       String
  decidedAt         DateTime  @default(now())
  confidence        Float?
  references        Json      @default("[]")

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  artifacts Artifact[]

  @@index([workspaceId])
  @@map("decisions")
}

// ---------------------------------------------------------------------------
// Event — system journal; also carries the structured collaboration
// "messages" from spec section 5 (agent.intention, agent.action_result,
// agent.blocker, agent.validation_request, ...) via `type` + `payload`.
// ---------------------------------------------------------------------------

enum EventSeverity {
  DEBUG
  INFO
  WARNING
  ERROR
  CRITICAL
}

model Event {
  id          String        @id @default(uuid())
  workspaceId String
  type        String
  severity    EventSeverity @default(INFO)
  actor       Json
  target      Json?
  payload     Json          @default("{}")
  createdAt   DateTime      @default(now())

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  notifications Notification[]
  receipts      EventReceipt[]

  @@index([workspaceId])
  @@index([type])
  @@map("events")
}

/// An actor's acknowledgement of an Event — kept separate so Event itself
/// never grows a read-state field (spec 3.3). No workspaceId of its own:
/// it's reached only through its parent Event.
enum EventReceiptStatus {
  SEEN
  ACKNOWLEDGED
  ACTED
}

model EventReceipt {
  id             String             @id @default(uuid())
  eventId        String
  actorType      ActorType
  actorId        String
  status         EventReceiptStatus
  seenAt         DateTime?
  acknowledgedAt DateTime?
  actedAt        DateTime?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, actorType, actorId])
  @@index([eventId])
  @@map("event_receipts")
}

// ---------------------------------------------------------------------------
// Notification — unifies chat message and system alert (spec 13.1, "Option A").
// Notification is the broadcast/message itself; NotificationRecipient is one
// row PER ACTUAL RECIPIENT, resolved immediately at creation (never a to:all
// string reinterpreted at read time — that was the exact failure mode this
// design is meant to avoid, per the agent-chat v2 collaboration).
// ---------------------------------------------------------------------------

enum NotificationKind {
  CHAT_MESSAGE
  SYSTEM_ALERT
}

enum NotificationScope {
  DIRECT
  BROADCAST
}

model Notification {
  id            String            @id @default(uuid())
  workspaceId   String
  kind          NotificationKind
  scope         NotificationScope
  taskId        String?
  title         String?
  body          String
  payload       Json              @default("{}")
  linkedEventId String?
  /// {type, id} — broader than the strict ActorType enum, same precedent as
  /// Event.actor: a system_alert can be raised by the system itself.
  createdBy     Json
  createdAt     DateTime          @default(now())

  workspace   Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  linkedEvent Event?                 @relation(fields: [linkedEventId], references: [id], onDelete: SetNull)
  recipients  NotificationRecipient[]

  @@index([workspaceId])
  @@map("notifications")
}

enum NotificationDeliveryStatus {
  PENDING
  DELIVERED
  SEEN
  ACKNOWLEDGED
  ACTED_ON
  FAILED
}

model NotificationRecipient {
  id             String                     @id @default(uuid())
  notificationId String
  recipientType  ActorType
  recipientId    String
  deliveryStatus NotificationDeliveryStatus @default(PENDING)
  deliveredAt    DateTime?
  /// Set once, at the FIRST transition to SEEN — never overwritten afterward.
  readAt         DateTime?
  acknowledgedAt DateTime?
  actionTakenAt  DateTime?
  /// Updated on every (re-)view, even after readAt is already set —
  /// distinct from readAt which only ever records the first one.
  lastSeenAt     DateTime?
  failureReason  String?

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, recipientType, recipientId])
  @@index([notificationId])
  /// Backs the cross-workspace "unread" query (spec 13.2): filter by
  /// recipient, readAt IS NULL — no workspaceId in this table by design.
  @@index([recipientType, recipientId, readAt])
  @@map("notification_recipients")
}

// ---------------------------------------------------------------------------
// Artifact — spec file 4: a real entity/service, not a passive JSON list on
// its parents. Optionally linked to a goal, task, decision and/or process at
// once (spec says "linked to a task or goal" but also lists decision/process
// relations separately, so all four are independent optional links rather
// than a single polymorphic one).
// ---------------------------------------------------------------------------

enum ArtifactType {
  FILE
  NOTE
  SPEC
  DIFF
  SCREENSHOT
  LOG
  DOCUMENT
  DECISION_EXPORT
  BUNDLE
}

enum ArtifactStatus {
  ACTIVE
  ARCHIVED
}

model Artifact {
  id            String         @id @default(uuid())
  workspaceId   String
  goalId        String?
  taskId        String?
  decisionId    String?
  processId     String?
  type          ArtifactType
  name          String
  description   String?
  status        ArtifactStatus @default(ACTIVE)
  version       Int            @default(1)
  /// Append-only log of prior versions: [{ version, contentRef, checksum, createdAt, createdByType, createdById }]
  versions      Json           @default("[]")
  source        String?
  contentRef    String?
  checksum      String?
  createdByType ActorType
  createdById   String
  updatedByType ActorType?
  updatedById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  goal      Goal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  decision  Decision? @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  process   Process?  @relation(fields: [processId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([goalId])
  @@index([taskId])
  @@index([decisionId])
  @@index([processId])
  @@map("artifacts")
}

// ---------------------------------------------------------------------------
// RuntimeCommand — persisted command queue between the hub (this API) and a
// LocalMachine daemon. Postgres-backed on purpose (no new broker dependency):
// a use-case enqueues a row instead of executing anything directly;
// MachineGateway delivers PENDING rows to a machine once it connects.
// ---------------------------------------------------------------------------

enum RuntimeCommandType {
  START_PROCESS
  STOP_PROCESS
  START_SESSION
  STOP_SESSION
}

enum RuntimeCommandStatus {
  PENDING
  SENT
  ACKNOWLEDGED
  COMPLETED
  FAILED
}

model RuntimeCommand {
  id          String               @id @default(uuid())
  machineId   String
  workspaceId String
  type        RuntimeCommandType
  payload     Json
  status      RuntimeCommandStatus @default(PENDING)
  createdAt   DateTime             @default(now())
  completedAt DateTime?

  machine   LocalMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([machineId, status])
  @@map("runtime_commands")
}
